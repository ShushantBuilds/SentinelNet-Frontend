{
  "manifest_version": 3,
  "name": "SentinelNet Shield",
  "version": "1.0.1",
  "description": "AI-powered checkout protection against e-commerce fraud and phishing.",
  "action": {
    "default_popup": "index.html",
    "default_title": "Open SentinelNet Shield"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "icons": {
    "16": "fraud-detection.png",
    "48": "fraud-detection.png",
    "128": "fraud-detection.png"
  }
}